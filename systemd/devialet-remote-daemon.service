# systemd --user unit for devialet-remote-daemon - the standalone UDP
# 45454 status-listener that pushes amp state to QML over D-Bus. See
# CLAUDE.md's "Daemon lifecycle" for why this is a systemd-managed
# process (crash recovery, query-ability via `systemctl --user
# is-active`) rather than in-process or XDG autostart.
#
# ExecStart is a bare command name, not an absolute path (Phase 13.0.2,
# settled - matches the devialet-ctl/devialet-chime placement decided in
# Phase 13.0.0). The daemon binary is built in release profile and copied
# to /usr/local/bin, which is on systemd's fixed unit search path for a
# non-absolute ExecStart (`man systemd.service`, "$PATH" section:
# "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin" in the system
# manager; confirmed for the user manager on this machine too). That
# means this file needs no per-clone path substitution at all - install
# it as-is via `scripts/install-daemon-unit.sh` (or a straight copy to
# `~/.config/systemd/user/`), no `sed` step, unlike the pre-13.0.2
# `@@EXECSTART@@` placeholder this file used to carry.
#
# If the binary isn't at /usr/local/bin yet (e.g. right after cloning,
# before the first `cargo build --release` + `install`), systemd fails
# the unit and reports so via `systemctl --user status
# devialet-remote-daemon.service` / `journalctl --user -u
# devialet-remote-daemon.service` - it does not silently do nothing.
# Restart=on-failure then keeps retrying (and keeps failing) on a fixed
# backoff until the binary shows up at that path.

[Unit]
Description=Devialet Expert remote status listener (UDP 45454 -> D-Bus)

[Service]
Type=simple
ExecStart=devialet-remote-daemon
Restart=on-failure

[Install]
# plasma-workspace.target Requires=graphical-session.target (confirmed on
# the dev machine via `systemctl --user show plasma-workspace.target`),
# so activating it guarantees the full graphical session - including the
# D-Bus session bus this daemon registers on - is already up. Matches
# CLAUDE.md's "Daemon lifecycle" decision.
WantedBy=plasma-workspace.target
