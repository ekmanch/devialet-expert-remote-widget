<?xml version="1.0" encoding="UTF-8"?>
<!--
  Phase 4.4.0: minimal kcfg skeleton, no entries yet - this phase's
  ConfigGeneral.qml has no settings, just a static brand header. Added now
  rather than deferred to Phase 4.4.1 because every config.qml-shipping
  applet found on this system (checked, not assumed - see config.qml's
  own doc comment) also ships a main.xml alongside it; Phase 4.4.1 will
  add real <entry> elements here (blur, reduce-motion, scroll-step,
  launch-at-login display) per CLAUDE.md's Repository Layout.
-->
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <kcfgfile name="" />
  <group name="General">
    <!-- Phase 4.4.2: volume step size used by the main view's +/- buttons
         and slider stepSize, and by the settings page's "Step per scroll
         notch" segmented control. Default 1.0 matches that control's
         Phase 4.4.1 mockup default ("1 dB" active). -->
    <entry name="volumeStepDb" type="Double">
      <default>1.0</default>
    </entry>
  </group>
</kcfg>
